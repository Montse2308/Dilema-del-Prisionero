{
  "name": "dilema-prisionero",
  "private": true,
  "description": "Evolutionary simulation of personal guilt and partner-specific commitment.",
  "license": "MIT",
  "author": "Montserrat Ximena Hernández Gallegos",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "pretest": "npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:curve": "vitest run --config vitest.export.config.ts",
    "reproduce": "vitest run --config vitest.reproduce.config.ts",
    "reproduce:r1": "vitest run --config vitest.reproduce.config.ts r1-protocol-null",
    "reproduce:r2": "vitest run --config vitest.reproduce.config.ts r2-open-at-076",
    "reproduce:r3": "vitest run --config vitest.reproduce.config.ts r3-s-axis",
    "reproduce:r4": "vitest run --config vitest.reproduce.config.ts r4-finite-size",
    "reproduce:r5": "vitest run --config vitest.reproduce.config.ts r5-structural-beta1",
    "reproduce:r6": "vitest run --config vitest.reproduce.config.ts r6-curve-illustration"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
